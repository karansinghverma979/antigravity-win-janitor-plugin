# Auto detect text files and perform LF normalization
* text=auto eol=lf

# PowerShell scripts must use CRLF on Windows systems
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.reg text eol=crlf

# Shell & configuration files
*.sh text eol=lf
*.bash text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
